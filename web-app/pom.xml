<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.wildfly.example</groupId>
        <artifactId>two-way-ssl</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>web-app</artifactId>
    <packaging>war</packaging>

    <name>WildFly Example: Web Application</name>
    <description/>

    <properties>
        <jboss.home>${project.build.directory}${file.separator}wildfly</jboss.home>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.wildfly.example</groupId>
            <artifactId>shared</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <configuration>
                    <jboss-home>${jboss.home}</jboss-home>
                    <provisioning-dir>${jboss.home}</provisioning-dir>
                    <feature-packs>
                        <feature-pack>
                            <groupId>org.wildfly</groupId>
                            <artifactId>wildfly-ee-galleon-pack</artifactId>
                        </feature-pack>
                    </feature-packs>
                    <channels>
                        <channel>
                            <manifest>
                                <groupId>org.wildfly.channels</groupId>
                                <artifactId>wildfly-ee</artifactId>
                            </manifest>
                        </channel>
                    </channels>
                    <layers>
                        <layer>ee-core-profile-server</layer>
                        <layer>elytron</layer>
                        <layer>management</layer>
                        <layer>core-tools</layer>
                    </layers>
                    <galleon-options>
                        <jboss-fork-embedded>true</jboss-fork-embedded>
                    </galleon-options>
                    <commands>
                        <command>/subsystem=logging/console-handler=CONSOLE:undefine-attribute(name=level)</command>
                        <command>/subsystem=logging/logger=org.wildfly.security:add(level=TRACE)</command>
                        <command>/subsystem=elytron/key-store=tckKs:add(path=client.truststore.pkcs12,relative-to=jboss.server.config.dir,credential-reference={clear-text=change.it.12345},type=PKCS12)</command>
                        <command>/subsystem=elytron/key-store=tckKs:import-certificate(alias=tomcat,path=&quot;/tmp/test-ssl-config/shared.cert&quot;,credential-reference={clear-text=change.it.12345},trust-cacerts=true,validate=false)</command>
                        <command>/subsystem=elytron/key-store=tckKs:store()</command>
                        <command>/subsystem=elytron/key-manager=tckKm:add(key-store=tckKs,credential-reference={clear-text=change.it.12345})</command>
                        <command>/subsystem=elytron/trust-manager=tckTm:add(key-store=tckKs)</command>
                        <command>/subsystem=elytron/client-ssl-context=tckSsl:add(key-manager=tckKm,trust-manager=tckTm)</command>
                        <command>/subsystem=elytron:write-attribute(name=default-ssl-context, value=tckSsl)</command>
                        <command>reload</command>
                    </commands>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>